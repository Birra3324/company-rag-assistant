# Copy to .env and fill in. Never commit real secrets.
APP_NAME=Company RAG Knowledge Assistant
APP_ENV=development
LOG_LEVEL=INFO

# local (default, no download) | sentence-transformers | openai
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384
SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# extractive (default, no LLM) | openai | ollama
LLM_PROVIDER=extractive
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Only required when EMBEDDING_PROVIDER=openai or LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=45

# sqlite (default) | chroma
VECTOR_BACKEND=sqlite
VECTOR_STORE_PATH=data/vectorstore/rag.sqlite3
CHROMA_PATH=data/vectorstore/chroma
DOCS_PATH=data/sample_docs

# CHUNK_SIZE / CHUNK_OVERLAP are approximate word tokens, not characters.
# ~4 English characters per token; Day 11's 700-char window ≈ 180 tokens.
CHUNK_SIZE=180
CHUNK_OVERLAP=40
RETRIEVE_K=4
RETRIEVE_POOL=24
MIN_RETRIEVE_SCORE=0.08
AUTO_INGEST_ON_STARTUP=true
